{
    "name": "hametuha/kagome-php",
    "description": "PHP wrapper for Kagome Japanese morphological analyzer",
    "type": "library",
    "keywords": ["kagome", "japanese", "morphological-analysis", "nlp"],
    "license": "MIT",
    "authors": [
        {
            "name": "Fumiki Takahashi",
            "email": "fumikito@example.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Hametuha\\Kagome\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hametuha\\Kagome\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs",
        "phpcs-fix": "phpcbf",
        "check": ["@phpcs", "@test"]
    }
}