<?xml version="1.0"?>
<ruleset name="Kagome PHP Coding Standard">
    <description>Kagome PHP coding standard</description>
    
    <!-- Paths to check -->
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    
    <!-- Exclude vendor directory -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    
    <!-- Use PSR-12 as base standard -->
    <rule ref="PSR12"/>
    
    <!-- PHP version compatibility -->
    <config name="testVersion" value="8.1-"/>
    
    <!-- Show progress -->
    <arg value="p"/>
    
    <!-- Show sniff codes in reports -->
    <arg value="s"/>
    
    <!-- Use colors in output -->
    <arg name="colors"/>
</ruleset>